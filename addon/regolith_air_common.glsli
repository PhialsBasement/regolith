// Shared by the air passes (Hillaire 2020, "A Scalable and
// Production Ready Sky and Atmosphere Rendering Technique").
// Body frame, metres; radiance for a sun of illuminance 1.

const float PI = 3.14159265358979;
const ivec2 T_SIZE = ivec2(256, 64);
const ivec2 MS_SIZE = ivec2(32, 32);
const ivec2 SV_SIZE = ivec2(192, 108);
const ivec3 AP_SIZE = ivec3(32, 32, 32);

layout(set = 0, binding = 0, std140) uniform Air {
	vec4 radii; // x bottom, y top, z camera radius, w has air
	vec4 rayleigh; // rgb per m, w scale height
	vec4 mie_s; // rgb per m, w scale height
	vec4 mie_a; // rgb per m
	vec4 mie_g; // rgb forward phase
	vec4 ozone; // rgb per m at the peak, w centre
	// x ozone half width, y sun radius (rad), z datum, w the
	// LUTs' base radius (under all ground: camera independent)
	vec4 misc;
	vec4 albedo; // rgb ground albedo
	vec4 eye; // xyz camera (body), w aerial range (m)
	vec4 sun; // xyz to the sun (body), w top illuminance
	vec4 body_r0, body_r1, body_r2; // render to body, rows
	vec4 cam_x, cam_y, cam_z; // view axes, render space
	mat4 inv_proj;
	vec4 size; // xy image size, z exposure, w airglow
	vec4 icrf_r0, icrf_r1, icrf_r2; // body to ICRF, rows
	vec4 stars; // x pixel angle, y star scale, w milky way unit
	vec4 glow_color; // airglow tint, luminance 1
} a;

struct Medium {
	vec3 scat_r;
	vec3 scat_m;
	vec3 ext;
};

Medium medium(float r) {
	// height over the datum: under it (a basin) the air is denser
	float h = r - a.misc.z;
	float dr = exp(-h / a.rayleigh.w);
	float dm = exp(-h / a.mie_s.w);
	float doz = max(0.0, 1.0 - abs(h - a.ozone.w) / a.misc.x);
	Medium m;
	m.scat_r = a.rayleigh.rgb * dr;
	m.scat_m = a.mie_s.rgb * dm;
	m.ext = m.scat_r + (a.mie_s.rgb + a.mie_a.rgb) * dm + a.ozone.rgb * doz;
	return m;
}

// r^2 - s^2 without float32 cancellation at planet radii
float sq_diff(float r, float s) {
	return (r - s) * (r + s);
}

// distance to a sphere about the centre; -1 when missed
float sphere_near(vec3 o, vec3 d, float radius) {
	float b = dot(o, d);
	float c = sq_diff(length(o), radius);
	float disc = b * b - c;
	if (disc < 0.0) {
		return -1.0;
	}
	float s = sqrt(disc);
	float t0 = -b - s;
	float t1 = -b + s;
	return t0 >= 0.0 ? t0 : (t1 >= 0.0 ? t1 : -1.0);
}

float sphere_far(vec3 o, vec3 d, float radius) {
	float b = dot(o, d);
	float c = sq_diff(length(o), radius);
	float disc = b * b - c;
	return disc < 0.0 ? -1.0 : -b + sqrt(disc);
}

float phase_rayleigh(float c) {
	return 3.0 / (16.0 * PI) * (1.0 + c * c);
}

// Cornette-Shanks, per colour
vec3 phase_mie(float c) {
	vec3 g = a.mie_g.rgb;
	vec3 g2 = g * g;
	vec3 k = 3.0 / (8.0 * PI) * (1.0 - g2) / (2.0 + g2);
	return k * (1.0 + c * c) / pow(1.0 + g2 - 2.0 * g * c, vec3(1.5));
}

float sub_to_unit(float u, float res) {
	return (u - 0.5 / res) * (res / (res - 1.0));
}

float unit_to_sub(float u, float res) {
	return (u + 0.5 / res) * (res / (res + 1.0));
}

// Bruneton's transmittance parameterisation
vec2 transmittance_uv(float r, float mu) {
	float bot = a.misc.w, top = a.radii.y;
	float H = sqrt(max(sq_diff(top, bot), 0.0));
	float rho = sqrt(max(sq_diff(r, bot), 0.0));
	// r^2 (mu^2 - 1) + top^2, rearranged to keep precision
	float disc = sq_diff(top, r) + r * r * mu * mu;
	float d = max(0.0, -r * mu + sqrt(max(disc, 0.0)));
	float d_min = top - r;
	float d_max = rho + H;
	float x_mu = clamp((d - d_min) / max(d_max - d_min, 1e-3), 0.0, 1.0);
	float x_r = clamp(rho / H, 0.0, 1.0);
	return vec2(unit_to_sub(x_mu, float(T_SIZE.x)), unit_to_sub(x_r, float(T_SIZE.y)));
}

void uv_to_transmittance(vec2 uv, out float r, out float mu) {
	float bot = a.misc.w, top = a.radii.y;
	float H = sqrt(max(sq_diff(top, bot), 0.0));
	float rho = H * uv.y;
	r = sqrt(rho * rho + bot * bot);
	float d_min = top - r;
	float d_max = rho + H;
	float d = d_min + uv.x * (d_max - d_min);
	mu = d == 0.0 ? 1.0 : (H * H - rho * rho - d * d) / (2.0 * r * d);
	mu = clamp(mu, -1.0, 1.0);
}

// the multiple scattering LUT: sun cosine across, radius up
vec2 ms_uv(float r, float mu_s) {
	vec2 uv = vec2(mu_s * 0.5 + 0.5, (r - a.misc.w) / (a.radii.y - a.misc.w));
	return clamp(vec2(unit_to_sub(uv.x, float(MS_SIZE.x)), unit_to_sub(uv.y, float(MS_SIZE.y))), 0.0, 1.0);
}

// The sky view: the sun's side of the sky by angle from the
// sun's azimuth (it is symmetric), the view zenith packed
// toward the horizon (Hillaire 2020, section 5.3).
vec2 skyview_uv(float r, float view_zenith_cos, float light_view_cos, bool hits_ground) {
	float bot = a.radii.x;
	float v_horizon = sqrt(max(sq_diff(r, bot), 0.0));
	float cos_beta = v_horizon / r;
	float beta = acos(clamp(cos_beta, -1.0, 1.0));
	float zenith_horizon = PI - beta;
	float v;
	if (!hits_ground) {
		float coord = acos(clamp(view_zenith_cos, -1.0, 1.0)) / zenith_horizon;
		coord = 1.0 - coord;
		coord = sqrt(max(coord, 0.0));
		coord = 1.0 - coord;
		v = coord * 0.5;
	} else {
		float coord = (acos(clamp(view_zenith_cos, -1.0, 1.0)) - zenith_horizon) / beta;
		coord = sqrt(max(coord, 0.0));
		v = coord * 0.5 + 0.5;
	}
	float u = sqrt(clamp(-light_view_cos * 0.5 + 0.5, 0.0, 1.0));
	return vec2(unit_to_sub(u, float(SV_SIZE.x)), unit_to_sub(v, float(SV_SIZE.y)));
}

// Single plus multiple scattering along a ray, from o for
// t_max metres; L for a sun of illuminance 1, T throughput.
struct Scatter {
	vec3 L;
	vec3 T;
};

#ifdef AIR_HAS_LUTS
Scatter integrate(vec3 o, vec3 d, float t_max, int steps, vec3 sun, float ground, sampler2D t_lut,
		sampler2D ms_lut) {
	Scatter s;
	s.L = vec3(0.0);
	s.T = vec3(1.0);
	float c = dot(d, sun);
	float pr = phase_rayleigh(c);
	vec3 pm = phase_mie(c);
	float t = 0.0;
	for (int i = 0; i < steps; i++) {
		// denser steps near the start, where the air is thickest
		float t_next = t_max * pow(float(i + 1) / float(steps), 2.0);
		float dt = t_next - t;
		vec3 p = o + d * (t + 0.5 * dt);
		float r = length(p);
		vec3 up = p / r;
		float mu_s = dot(up, sun);
		Medium m = medium(r);
		// air under the sphere (real ground lies lower there): its
		// sunlight as at the sphere's surface
		float rl = max(r, ground + 1.0);
		vec3 t_sun = textureLod(t_lut, transmittance_uv(rl, mu_s), 0.0).rgb;
		float lit = sphere_near(up * rl, sun, ground) < 0.0 ? 1.0 : 0.0;
		vec3 ms = textureLod(ms_lut, ms_uv(rl, mu_s), 0.0).rgb;
		vec3 S = t_sun * lit * (m.scat_r * pr + m.scat_m * pm) + ms * (m.scat_r + m.scat_m);
		vec3 st = exp(-m.ext * dt);
		vec3 ext = max(m.ext, vec3(1e-12));
		s.L += s.T * (S - S * st) / ext;
		s.T *= st;
		t = t_next;
	}
	return s;
}
#endif

vec3 to_body(vec3 v) {
	return vec3(dot(a.body_r0.xyz, v), dot(a.body_r1.xyz, v), dot(a.body_r2.xyz, v));
}
