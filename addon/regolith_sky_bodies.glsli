// Planets and moons: Lambert spheres lit by the sun, a shaded
// disk once wider than a pixel, a point of their whole light
// below that. Units as the stars (suns at 1 AU, x stars.y).

layout(set = 0, binding = 11, std430) restrict readonly buffer Bodies {
	// per body: dir (body frame), angular radius; dir to the
	// sun from it, 1 / (AU from the sun)^2; geometric albedo rgb
	vec4 b[];
} bodies;

vec3 sky_bodies(vec3 d, vec3 Tv) {
	vec3 col = vec3(0.0);
	float pix = max(a.stars.x, 1e-6);
	float sigma = 0.8 * pix;
	int n = int(a.stars.z);
	for (int i = 0; i < n; i++) {
		vec4 p = bodies.b[3 * i];
		vec4 s = bodies.b[3 * i + 1];
		vec3 albedo = bodies.b[3 * i + 2].rgb;
		vec3 c = p.xyz;
		float rad = p.w;
		// off the centre, across the line of sight: exact for
		// a far body, and precise at any angular size
		vec3 q = d - c * dot(d, c);
		float off = length(q);
		if (dot(d, c) <= 0.0 || off > rad + 6.0 * sigma) {
			continue;
		}
		float cos_alpha = dot(s.xyz, -c);
		float alpha = acos(clamp(cos_alpha, -1.0, 1.0));
		// the whole body as a point: p s^2 phi(alpha) suns
		float phi = (sin(alpha) + (PI - alpha) * cos_alpha) / PI;
		float w = clamp(rad / pix - 0.75, 0.0, 1.0);
		if (w < 1.0) {
			float e = phi * rad * rad * s.w;
			float g = exp(-off * off / (2.0 * sigma * sigma)) / (2.0 * PI * sigma * sigma);
			col += albedo * (e * g * (1.0 - w));
		}
		if (w > 0.0 && off < rad + pix) {
			// the visible hemisphere's normal at this pixel
			vec2 u = vec2(min(off / rad, 1.0), 0.0);
			vec3 n = (off > 0.0 ? q / off : vec3(0.0)) * u.x - c * sqrt(max(1.0 - u.x * u.x, 0.0));
			float cos_i = max(dot(n, s.xyz), 0.0);
			float edge = clamp((rad - off) / pix + 0.5, 0.0, 1.0);
			// Lambert: Bond-like albedo 1.5 p, radiance A E cos / pi
			col += albedo * (1.5 * s.w * cos_i / PI * edge * w);
		}
	}
	return col * a.stars.y * Tv;
}
