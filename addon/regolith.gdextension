[configuration]

entry_symbol = "regolith_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://addons/regolith/bin/libregolith.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/regolith/bin/libregolith.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/regolith/bin/libregolith.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/regolith/bin/libregolith.windows.template_release.x86_64.dll"
