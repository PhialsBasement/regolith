+// Once per engine frame: read the last frame's section cycles
+// (stalls the GPU), sum them per owner, clear; print SECT| lines
+// every section_profile_frames frames.
+void RenderForwardClustered::_section_profile_frame() {
+	const uint64_t frame = RSG::rasterizer->get_frame_number();
+	if (frame == section_profile_frame) {
+		return;
+	}
+	section_profile_frame = frame;
+	RD *rd = RD::get_singleton();
+	const uint32_t used = section_slots.size() * SECTION_KEYS_PER_SLOT * 2 * 4;
+	if (used > 0) {
+		const Vector<uint8_t> bytes = rd->buffer_get_data(section_profile_buffer, 0, used);
+		const uint32_t *d = reinterpret_cast<const uint32_t *>(bytes.ptr());
+		for (uint32_t s = 0; s < section_slots.size(); s++) {
+			for (uint32_t k = 0; k < SECTION_KEYS_PER_SLOT; k++) {
+				const uint32_t at = (s * SECTION_KEYS_PER_SLOT + k) * 2;
+				if (d[at + 1] == 0) {
+					continue;
+				}
+				// k = (class * 2 + stage) * 16 + section
+				const SectionSlot &slot = section_slots[s];
+				const String key = vformat("%d|%d|%d|%d|%d|%d", int64_t(slot.owner_id), int64_t(slot.instance_rid), int(slot.surface), int(k / 32), int((k / 16) % 2), int(k % 16));
+				SectionSum &sum = section_sums[key];
+				sum.cycles += d[at];
+				sum.waves += d[at + 1];
+			}
+		}
+		rd->buffer_clear(section_profile_buffer, 0, used);
+	}
+	section_slots.clear();
+	if (++section_profile_count >= section_profile_frames) {
+		// owner|rid|surface|class|stage|section, then per frame
+		// cycles and waves; class 0 color 1 depth+normal 2 depth
+		print_line(vformat("SECT|BEGIN|%d", int64_t(frame)));
+		for (const KeyValue<String, SectionSum> &E : section_sums) {
+			print_line(vformat("SECT|%d|%s|%.0f|%.1f", section_profile_count, E.key, double(E.value.cycles) / section_profile_count, double(E.value.waves) / section_profile_count));
+		}
+		section_sums.clear();
+		section_profile_count = 0;
+	}
+}
