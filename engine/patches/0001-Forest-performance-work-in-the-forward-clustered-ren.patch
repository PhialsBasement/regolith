+void RenderForwardClustered::_forest_profiled_list(RenderListParameters *p_params, RID p_framebuffer, BitField<RD::DrawFlags> p_draw_flags, const Vector<Color> &p_clear_color_values, float p_clear_depth_value, uint32_t p_clear_stencil_value, const Rect2 &p_region, const Rect2i &p_scissor) {
+	// forest-perf: split the list into runs of one mesh surface and
+	// material, each in its own draw list behind a GPU timestamp
+	RD *rd = RD::get_singleton();
+	RD::FramebufferFormatID fb_format = rd->framebuffer_get_format(p_framebuffer);
+	p_params->framebuffer_format = fb_format;
+	uint32_t n = p_params->element_count;
+	uint32_t from = 0;
+	bool first = true;
+	while (from < n) {
+		const GeometryInstanceSurfaceDataCache *s0 = p_params->elements[from];
+		uint32_t to = from + 1;
+		while (to < n) {
+			const GeometryInstanceSurfaceDataCache *s = p_params->elements[to];
+			if (s->surface != s0->surface || s->material != s0->material || s->owner->data->base != s0->owner->data->base) {
+				break;
+			}
+			to++;
+		}
+		rd->capture_timestamp(vformat("D|%s|%d|%d", forest_pass_label, (int64_t)s0->owner->data->base.get_id(), s0->surface_index));
+		BitField<RD::DrawFlags> fl = first ? p_draw_flags : BitField<RD::DrawFlags>(RD::DRAW_DEFAULT_ALL);
+		RD::DrawListID dl = rd->draw_list_begin(p_framebuffer, fl, p_clear_color_values, p_clear_depth_value, p_clear_stencil_value, p_region);
+		if (forest_diag_geo_only) {
+			// isolation: every triangle is processed, no pixels drawn
+			rd->draw_list_enable_scissor(dl, Rect2(0, 0, 1, 1));
+		} else if (p_scissor.get_area() > 0) {
+			rd->draw_list_enable_scissor(dl, p_scissor);
+		}
+		_render_list(dl, fb_format, p_params, from, to);
+		rd->draw_list_end();
+		first = false;
+		from = to;
+	}
+	rd->capture_timestamp(vformat("D|%s|end", forest_pass_label));
+	if (Engine::get_singleton()->get_frames_drawn() % 240 == 0) {
+		print_line(vformat("FOREST draws %s total=%d uber=%d", forest_pass_label, forest_draws_total, forest_draws_uber));
+	}
+	forest_draws_total = 0;
+	forest_draws_uber = 0;
+}
