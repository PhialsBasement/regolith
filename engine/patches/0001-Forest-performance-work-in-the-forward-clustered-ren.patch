+bool RendererSceneCull::_forest_reuse_cascade(RID p_light, int p_cascade, const Cull::Shadow::Cascade &p_c) {
+	// Returns true when this frame skips rendering the cascade and
+	// samples last frame's map with the matrices it was made with.
+	ForestCascadeCache &k = forest_cascade_cache[p_light].c[p_cascade];
+	uint64_t frame = RSG::rasterizer->get_frame_number();
+	// first=1: even frames 1+2, odd 3. first=0: even 0+3, odd 1+2,
+	// which balances the four cascades' cost across frames
+	bool even = (frame & 1) == 0;
+	bool due;
+	if (forest_amort_first == 0) {
+		due = (p_cascade == 0 || p_cascade == 3) ? even : !even;
+	} else {
+		due = p_cascade < forest_amort_first || (p_cascade == 3 ? !even : even);
+	}
+	if (p_cascade == 3 && forest_amort_far_period > 2) {
+		// far cascade: one frame in N, on frames the others skip
+		due = (frame % forest_amort_far_period) == 1;
+	}
+	const real_t eps = 1e-4;
+	bool covers = k.valid && p_c.lx.is_equal_approx(k.lx) && p_c.ly.is_equal_approx(k.ly) &&
+			p_c.vx0 >= k.sx0 && p_c.vx1 <= k.sx1 && p_c.vy0 >= k.sy0 && p_c.vy1 <= k.sy1 &&
+			p_c.vz0 >= k.oz0 - eps && p_c.vz1 <= k.oz1 + eps;
+	if (!due && covers) {
+		RSG::light_storage->light_instance_set_shadow_transform(p_light, k.projection, k.transform, k.zfar, k.split, p_cascade, k.texel, k.bias_scale, k.range_begin, k.uv_scale);
+		forest_reused_cascades++;
+		return true;
+	}
+	k.valid = true;
+	k.projection = p_c.projection;
+	k.transform = p_c.transform;
+	k.zfar = p_c.zfar;
+	k.split = p_c.split;
+	k.texel = p_c.shadow_texel_size;
+	k.bias_scale = p_c.bias_scale;
+	k.range_begin = p_c.range_begin;
+	k.uv_scale = p_c.uv_scale;
+	k.scissor = p_c.scissor;
+	k.lx = p_c.lx;
+	k.ly = p_c.ly;
+	k.sx0 = p_c.sx0;
+	k.sx1 = p_c.sx1;
+	k.sy0 = p_c.sy0;
+	k.sy1 = p_c.sy1;
+	k.oz0 = p_c.oz0;
+	k.oz1 = p_c.oz1;
+	return false;
+}
