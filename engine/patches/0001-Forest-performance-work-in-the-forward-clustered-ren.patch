+bool RendererSceneCull::_forest_in_sample_rect(const Cull::Shadow::Cascade &p_c, const InstanceBounds &p_b) {
+	// Project the AABB onto the light x and y axes; a caster whose
+	// footprint misses the samplable rect writes no sampled texel.
+	Vector3 mn(p_b.bounds[0], p_b.bounds[1], p_b.bounds[2]);
+	Vector3 mx(p_b.bounds[3], p_b.bounds[4], p_b.bounds[5]);
+	Vector3 c = (mn + mx) * 0.5;
+	Vector3 e = (mx - mn) * 0.5;
+	real_t cx = p_c.lx.dot(c);
+	real_t rx = Math::abs(p_c.lx.x) * e.x + Math::abs(p_c.lx.y) * e.y + Math::abs(p_c.lx.z) * e.z;
+	if (cx + rx < p_c.sx0 || cx - rx > p_c.sx1) {
+		return false;
+	}
+	real_t cy = p_c.ly.dot(c);
+	real_t ry = Math::abs(p_c.ly.x) * e.x + Math::abs(p_c.ly.y) * e.y + Math::abs(p_c.ly.z) * e.z;
+	return !(cy + ry < p_c.sy0 || cy - ry > p_c.sy1);
+}
