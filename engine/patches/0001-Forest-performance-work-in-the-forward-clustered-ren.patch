+static const char *forest_occ_glsl = R"(
+#version 450
+layout(local_size_x = 16, local_size_y = 16) in;
+layout(set = 0, binding = 0) uniform sampler2D depth_tex;
+layout(set = 0, binding = 1, std430) buffer Out { float tiles[]; };
+layout(push_constant, std430) uniform PC {
+	mat4 inv_proj;
+	ivec2 size;
+	ivec2 tiles_n;
+} pc;
+shared float smin[256];
+void main() {
+	ivec2 t = ivec2(gl_WorkGroupID.xy);
+	ivec2 l = ivec2(gl_LocalInvocationID.xy);
+	ivec2 tp = (pc.size + pc.tiles_n - 1) / pc.tiles_n;
+	float m = 1.0;
+	for (int y = l.y; y < tp.y; y += 16) {
+		for (int x = l.x; x < tp.x; x += 16) {
+			ivec2 p = t * tp + ivec2(x, y);
+			if (p.x < pc.size.x && p.y < pc.size.y) {
+				m = min(m, texelFetch(depth_tex, p, 0).r);
+			}
+		}
+	}
+	uint li = uint(l.y * 16 + l.x);
+	smin[li] = m;
+	barrier();
+	for (uint s = 128u; s > 0u; s >>= 1u) {
+		if (li < s) {
+			smin[li] = min(smin[li], smin[li + s]);
+		}
+		barrier();
+	}
+	if (li == 0u) {
+		float d = smin[0];
+		float dist = 1e30;
+		if (d > 0.0) {
+			vec4 v = pc.inv_proj * vec4(0.0, 0.0, d, 1.0);
+			dist = -v.z / v.w;
+		}
+		tiles[t.y * pc.tiles_n.x + t.x] = dist;
+	}
+}
+)";
+
+static LocalVector<Pair<Projection, Vector3>> forest_occ_pending;
+
+static void forest_occ_ready(const Vector<uint8_t> &p_data) {
+	if (forest_occ_pending.is_empty()) {
+		return;
+	}
+	Pair<Projection, Vector3> cam = forest_occ_pending[0];
+	forest_occ_pending.remove_at(0);
+	int n = ForestOcc::w * ForestOcc::h;
+	if (p_data.size() < n * 4) {
+		return;
+	}
+	ForestOcc::tiles.resize(n);
+	memcpy(ForestOcc::tiles.ptr(), p_data.ptr(), n * 4);
+	ForestOcc::capture_vp = cam.first;
+	ForestOcc::capture_pos = cam.second;
+	ForestOcc::version++;
+}
+
+void RenderForwardClustered::_forest_occ_dispatch(RenderDataRD *p_render_data, RID p_depth, const Size2i &p_size) {
+	RD *rd = RD::get_singleton();
+	if (forest_occ_shader.is_null()) {
+		String err;
+		Vector<uint8_t> spirv = rd->shader_compile_spirv_from_source(RD::SHADER_STAGE_COMPUTE, forest_occ_glsl, RD::SHADER_LANGUAGE_GLSL, &err);
+		ERR_FAIL_COND_MSG(spirv.is_empty(), "forest occ shader: " + err);
+		Vector<RD::ShaderStageSPIRVData> stages;
+		RD::ShaderStageSPIRVData sd;
+		sd.shader_stage = RD::SHADER_STAGE_COMPUTE;
+		sd.spirv = spirv;
+		stages.push_back(sd);
+		forest_occ_shader = rd->shader_create_from_spirv(stages, "ForestOcc");
+		forest_occ_pipeline = rd->compute_pipeline_create(forest_occ_shader);
+	}
+	static int tile_px = OS::get_singleton()->get_environment("FOREST_OCC_TILE").is_empty() ? 8 : OS::get_singleton()->get_environment("FOREST_OCC_TILE").to_int();
+	int tw = Math::division_round_up(p_size.width, tile_px);
+	int th = Math::division_round_up(p_size.height, tile_px);
+	if (tw != ForestOcc::w || th != ForestOcc::h || forest_occ_buffer.is_null()) {
+		if (forest_occ_buffer.is_valid()) {
+			rd->free_rid(forest_occ_buffer);
+		}
+		forest_occ_buffer = rd->storage_buffer_create(tw * th * 4);
+		ForestOcc::w = tw;
+		ForestOcc::h = th;
+		ForestOcc::tiles.clear();
+		forest_occ_pending.clear();
+	}
+	if (forest_occ_pending.size() > 4) {
+		return; // readbacks still in flight
+	}
+	Projection proj = p_render_data->scene_data->get_cam_projection();
+	Transform3D xf = p_render_data->scene_data->cam_transform;
+	RID sampler = RendererRD::MaterialStorage::get_singleton()->sampler_rd_get_default(RSE::CANVAS_ITEM_TEXTURE_FILTER_NEAREST, RSE::CANVAS_ITEM_TEXTURE_REPEAT_DISABLED);
+	RD::Uniform u_depth(RD::UNIFORM_TYPE_SAMPLER_WITH_TEXTURE, 0, Vector<RID>({ sampler, p_depth }));
+	RD::Uniform u_out(RD::UNIFORM_TYPE_STORAGE_BUFFER, 1, forest_occ_buffer);
+	RID uset = UniformSetCacheRD::get_singleton()->get_cache(forest_occ_shader, 0, u_depth, u_out);
+	struct {
+		float inv_proj[16];
+		int32_t size[2];
+		int32_t tiles_n[2];
+	} pc;
+	Projection inv = proj.inverse();
+	for (int c = 0; c < 4; c++) {
+		for (int r = 0; r < 4; r++) {
+			pc.inv_proj[c * 4 + r] = inv.columns[c][r];
+		}
+	}
+	pc.size[0] = p_size.width;
+	pc.size[1] = p_size.height;
+	pc.tiles_n[0] = tw;
+	pc.tiles_n[1] = th;
+	RD::ComputeListID cl = rd->compute_list_begin();
+	rd->compute_list_bind_compute_pipeline(cl, forest_occ_pipeline);
+	rd->compute_list_bind_uniform_set(cl, uset, 0);
+	rd->compute_list_set_push_constant(cl, &pc, sizeof(pc));
+	rd->compute_list_dispatch(cl, tw, th, 1);
+	rd->compute_list_end();
+	forest_occ_pending.push_back(Pair<Projection, Vector3>(proj * Projection(xf.affine_inverse()), xf.origin));
+	// GPU cluster culling next frame reads these tiles directly
+	forest_occ_last_vp = proj * Projection(xf.affine_inverse());
+	forest_occ_last_pos = xf.origin;
+	forest_occ_last_valid = true;
+	rd->buffer_get_data_async(forest_occ_buffer, callable_mp_static(&forest_occ_ready));
+}
+
+void RenderForwardClustered::_forest_order_runs_front_to_back(RenderList &p_list, uint32_t p_from, uint32_t p_count) {
+	// Batches of one surface stay contiguous (instancing intact);
+	// batches are reordered by their nearest instance.
+	struct Run {
+		uint32_t from;
+		uint32_t count;
+		float depth;
+	};
+	LocalVector<Run> runs;
+	uint32_t n = p_count == UINT32_MAX ? p_list.elements.size() : p_from + p_count;
+	uint32_t from = p_from;
+	while (from < n) {
+		GeometryInstanceSurfaceDataCache *s0 = p_list.elements[from];
+		uint32_t to = from + 1;
+		while (to < n && p_list.elements[to]->sort.sort_key1 == s0->sort.sort_key1 && p_list.elements[to]->sort.sort_key2 == s0->sort.sort_key2) {
+			to++;
+		}
+		runs.push_back({ from, to - from, s0->owner->depth });
+		from = to;
+	}
+	struct ByDepth {
+		_FORCE_INLINE_ bool operator()(const Run &a, const Run &b) const {
+			return a.depth < b.depth;
+		}
+	};
+	SortArray<Run, ByDepth> sorter;
+	sorter.sort(runs.ptr(), runs.size());
+	forest_reorder_tmp.resize(n - p_from);
+	uint32_t w = 0;
+	for (const Run &r : runs) {
+		for (uint32_t i = 0; i < r.count; i++) {
+			forest_reorder_tmp[w++] = p_list.elements[r.from + i];
+		}
+	}
+	for (uint32_t i = 0; i < w; i++) {
+		p_list.elements[p_from + i] = forest_reorder_tmp[i];
+	}
+}
