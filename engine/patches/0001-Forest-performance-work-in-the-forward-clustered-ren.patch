@@ -0,0 +1,386 @@
+/**************************************************************************/
+/*  forest_occ.h                                                          */
+/**************************************************************************/
+
+#pragma once
+
+#include "core/math/projection.h"
+#include "core/math/transform_3d.h"
+#include "core/templates/local_vector.h"
+
+// forest-perf: camera occlusion from the GPU depth prepass.
+// The renderer reduces the prepass depth to a tile grid of the
+// farthest planar depth per tile; the culler tests instance AABBs
+// against the latest grid with the camera it was captured with.
+// forest-perf: CPU phase timers, microseconds summed per window
+struct ForestTime {
+	enum {
+		DRAW,
+		SCENE_UPDATE,
+		CULL_PREP,
+		CULL,
+		RENDER_SCENE,
+		RS_FILL_SORT,
+		RS_SHADOW_SETUP,
+		RS_RECORD,
+		RECV_BUILD,
+		SLOT_MAX
+	};
+	static inline uint64_t acc[SLOT_MAX] = {};
+	static inline uint64_t frames = 0;
+	static inline const char *names[SLOT_MAX] = { "draw", "scene_update", "cull_prep", "cull", "render_scene", "rs_fill_sort", "rs_shadows", "rs_record", "recv_build" };
+};
+
+struct ForestOcc {
+	static inline bool enabled = false;
+	static inline LocalVector<float> tiles;
+	static inline int w = 0;
+	static inline int h = 0;
+	static inline Projection capture_vp; // correction * proj * view
+	static inline Vector3 capture_pos;
+	static inline Vector3 cam_now;
+	static inline uint64_t culled = 0;
+	static inline uint64_t tested = 0;
+
+	static inline bool shadow_cull = false;
+	static inline uint64_t sh_tested = 0;
+	static inline uint64_t sh_culled = 0;
+	static inline uint64_t version = 0;
+	static inline Vector3 last_travel;
+
+	// Light-space 2D grid of everything the camera can see (surfaces
+	// and the air in front of them). A caster matters only if its
+	// light-space footprint touches a marked cell.
+	static constexpr int RG = 400;
+	static constexpr real_t RCELL = 2.0;
+	// one grid per cascade, each holding the visible points (and air)
+	// inside that cascade's camera depth slice
+	static constexpr int RCASC = 4;
+	static inline LocalVector<uint32_t> recv_sat[RCASC];
+	static inline uint64_t recv_version = 0;
+	static inline Vector3 rl_x, rl_y, rl_origin;
+	static inline real_t splits[RCASC + 1] = { 0, 1e6, 1e6, 1e6, 1e6 };
+	static inline int split_count = 0;
+
+	static inline LocalVector<uint8_t> recv_scratch[RCASC];
+	// per tile-group corner: ray direction and 1/cos to the view axis
+	static constexpr int RGROUP = 4;
+	static inline LocalVector<Vector3> grp_dir;
+	static inline LocalVector<real_t> grp_inv_cos;
+	static inline LocalVector<float> grp_far;
+	static inline int grp_w = 0, grp_h = 0;
+	static inline Vector3 build_travel;
+
+	static void _fill_poly(Vector2 *p_pts, int p_n, uint8_t *p_dst) {
+		// convex hull (monotone chain), then scanline fill
+		for (int i = 1; i < p_n; i++) {
+			for (int j = i; j > 0 && (p_pts[j].x < p_pts[j - 1].x || (p_pts[j].x == p_pts[j - 1].x && p_pts[j].y < p_pts[j - 1].y)); j--) {
+				SWAP(p_pts[j], p_pts[j - 1]);
+			}
+		}
+		Vector2 hull[24];
+		int k = 0;
+		for (int pass = 0; pass < 2; pass++) {
+			int start = k;
+			for (int ii = 0; ii < p_n; ii++) {
+				int i = pass == 0 ? ii : p_n - 1 - ii;
+				while (k >= start + 2 && (hull[k - 1] - hull[k - 2]).cross(p_pts[i] - hull[k - 2]) <= 0) {
+					k--;
+				}
+				hull[k++] = p_pts[i];
+			}
+			k--;
+		}
+		if (k < 3) {
+			k = MAX(k, 1);
+		}
+		real_t ymin = 1e30, ymax = -1e30;
+		for (int i = 0; i < k; i++) {
+			ymin = MIN(ymin, hull[i].y);
+			ymax = MAX(ymax, hull[i].y);
+		}
+		int r0 = CLAMP(int(Math::floor(ymin)), 0, RG - 1);
+		int r1 = CLAMP(int(Math::floor(ymax)), 0, RG - 1);
+		for (int r = r0; r <= r1; r++) {
+			// x extent of the hull inside the band [r, r + 1]
+			real_t y0 = r, y1 = r + 1;
+			real_t xl = 1e30, xr = -1e30;
+			for (int i = 0; i < k; i++) {
+				Vector2 a = hull[i], b = hull[(i + 1) % k];
+				real_t lo = MIN(a.y, b.y), hi = MAX(a.y, b.y);
+				if (hi < y0 || lo > y1) {
+					continue;
+				}
+				if (hi - lo < 1e-6) {
+					xl = MIN(xl, MIN(a.x, b.x));
+					xr = MAX(xr, MAX(a.x, b.x));
+					continue;
+				}
+				real_t ta = (CLAMP(y0, lo, hi) - a.y) / (b.y - a.y);
+				real_t tb = (CLAMP(y1, lo, hi) - a.y) / (b.y - a.y);
+				real_t xa = a.x + (b.x - a.x) * ta;
+				real_t xb = a.x + (b.x - a.x) * tb;
+				xl = MIN(xl, MIN(xa, xb));
+				xr = MAX(xr, MAX(xa, xb));
+			}
+			if (xl > xr) {
+				continue;
+			}
+			int c0 = CLAMP(int(Math::floor(xl)) - 1, 0, RG - 1);
+			int c1 = CLAMP(int(Math::floor(xr)) + 1, 0, RG - 1);
+			memset(p_dst + r * RG + c0, 1, c1 - c0 + 1);
+		}
+	}
+
+	// Shared setup on the calling thread; slices then build in
+	// parallel (build_slice is safe per distinct p_k).
+	static int prepare_receivers(const Vector3 &p_travel) {
+		recv_version = version;
+		build_travel = p_travel;
+		Vector3 up = Math::abs(p_travel.y) < 0.99 ? Vector3(0, 1, 0) : Vector3(1, 0, 0);
+		rl_x = p_travel.cross(up).normalized();
+		rl_y = p_travel.cross(rl_x).normalized();
+		rl_origin = capture_pos;
+		Projection inv = capture_vp.inverse();
+		auto unproject = [&](real_t nx, real_t ny) -> Vector3 {
+			Vector3 p = inv.xform(Vector3(nx, ny, 0.5));
+			return (p - capture_pos).normalized();
+		};
+		Vector3 fwd = unproject(0, 0);
+		grp_w = (w + RGROUP - 1) / RGROUP;
+		grp_h = (h + RGROUP - 1) / RGROUP;
+		grp_dir.resize((grp_w + 1) * (grp_h + 1));
+		grp_inv_cos.resize((grp_w + 1) * (grp_h + 1));
+		for (int y = 0; y <= grp_h; y++) {
+			for (int x = 0; x <= grp_w; x++) {
+				real_t nx = CLAMP(real_t(x * RGROUP) / w * 2.0 - 1.0, -1.0, 1.0);
+				real_t ny = CLAMP(real_t(y * RGROUP) / h * 2.0 - 1.0, -1.0, 1.0);
+				Vector3 d = unproject(nx, ny);
+				grp_dir[y * (grp_w + 1) + x] = d;
+				grp_inv_cos[y * (grp_w + 1) + x] = 1.0 / MAX(d.dot(fwd), (real_t)0.05);
+			}
+		}
+		// farthest planar depth of each group
+		grp_far.resize(grp_w * grp_h);
+		for (int gy = 0; gy < grp_h; gy++) {
+			for (int gx = 0; gx < grp_w; gx++) {
+				float far_d = 0;
+				for (int yy = gy * RGROUP; yy < MIN((gy + 1) * RGROUP, h); yy++) {
+					for (int xx = gx * RGROUP; xx < MIN((gx + 1) * RGROUP, w); xx++) {
+						far_d = MAX(far_d, tiles[yy * w + xx]);
+					}
+				}
+				grp_far[gy * grp_w + gx] = MIN(far_d, 400.0f) + 1.0f;
+			}
+		}
+		return CLAMP(split_count, 1, RCASC);
+	}
+
+	static void build_slice(uint32_t p_k) {
+		// slice k; with no split info the whole range in one grid
+		real_t d0 = split_count > 0 ? splits[p_k] : 0.0;
+		real_t d1 = split_count > 0 ? splits[p_k + 1] : 1e6;
+		d0 = MAX(d0 - 2.0, (real_t)0.0);
+		d1 += 2.0;
+		LocalVector<uint8_t> &buf = recv_scratch[p_k];
+		buf.resize(RG * RG);
+		memset(buf.ptr(), 0, RG * RG);
+		auto to_grid = [&](const Vector3 &p) -> Vector2 {
+			Vector3 d = p - rl_origin;
+			return Vector2(d.dot(rl_x) / RCELL + RG * 0.5, d.dot(rl_y) / RCELL + RG * 0.5);
+		};
+		const int GW = grp_w + 1;
+		for (int gy = 0; gy < grp_h; gy++) {
+			for (int gx = 0; gx < grp_w; gx++) {
+				real_t far_d = grp_far[gy * grp_w + gx];
+				if (far_d < d0) {
+					continue; // this group sees nothing in the slice
+				}
+				real_t a1 = MIN(far_d, d1);
+				Vector2 pts[8];
+				for (int c = 0; c < 4; c++) {
+					int ci = (gy + ((c & 2) ? 1 : 0)) * GW + gx + ((c & 1) ? 1 : 0);
+					const Vector3 &dir = grp_dir[ci];
+					real_t ic = grp_inv_cos[ci];
+					pts[c] = to_grid(capture_pos + dir * (d0 * ic));
+					pts[4 + c] = to_grid(capture_pos + dir * (a1 * ic));
+				}
+				_fill_poly(pts, 8, buf.ptr());
+			}
+		}
+		LocalVector<uint32_t> &sat = recv_sat[p_k];
+		const int W = RG + 1;
+		sat.resize(W * W);
+		memset(sat.ptr(), 0, W * sizeof(uint32_t));
+		for (int r = 0; r < RG; r++) {
+			uint32_t row_sum = 0;
+			sat[(r + 1) * W] = 0;
+			for (int c = 0; c < RG; c++) {
+				row_sum += buf[r * RG + c];
+				sat[(r + 1) * W + c + 1] = sat[r * W + c + 1] + row_sum;
+			}
+		}
+	}
+
+	// Light-space footprint rect of a caster in grid cells; false
+	// when it leaves the grid (then the caster is always kept).
+	static bool footprint(const real_t p_b[6], const Vector3 &p_travel, int r_rect[4]) {
+		if (w == 0 || tiles.is_empty()) {
+			return false;
+		}
+		last_travel = p_travel;
+		if (recv_version != version || recv_sat[0].is_empty()) {
+			return false; // built on the cull thread entry, not here
+		}
+		sh_tested++;
+		real_t x0 = 1e30, y0 = 1e30, x1 = -1e30, y1 = -1e30;
+		for (int j = 0; j < 8; j++) {
+			Vector3 c(j & 1 ? p_b[0] : p_b[3], j & 2 ? p_b[1] : p_b[4], j & 4 ? p_b[2] : p_b[5]);
+			Vector3 d = c - rl_origin;
+			real_t gx = d.dot(rl_x) / RCELL + RG * 0.5;
+			real_t gy = d.dot(rl_y) / RCELL + RG * 0.5;
+			x0 = MIN(x0, gx);
+			x1 = MAX(x1, gx);
+			y0 = MIN(y0, gy);
+			y1 = MAX(y1, gy);
+		}
+		// penumbra, motion and cascade reuse pad, in cells
+		real_t pad = (3.0 + cam_now.distance_to(capture_pos) * 2.0) / RCELL;
+		r_rect[0] = int(Math::floor(x0 - pad));
+		r_rect[1] = int(Math::floor(x1 + pad));
+		r_rect[2] = int(Math::floor(y0 - pad));
+		r_rect[3] = int(Math::floor(y1 + pad));
+		return r_rect[0] >= 0 && r_rect[2] >= 0 && r_rect[1] < RG && r_rect[3] < RG;
+	}
+
+	// True when the caster's footprint touches no visible point of
+	// cascade p_k's slice.
+	static bool unseen_in(const int p_rect[4], int p_k) {
+		int k = split_count > 0 ? CLAMP(p_k, 0, RCASC - 1) : 0;
+		if (recv_sat[k].is_empty()) {
+			return false;
+		}
+		const uint32_t *s = recv_sat[k].ptr();
+		const int W = RG + 1;
+		int c0 = p_rect[0], c1 = p_rect[1], r0 = p_rect[2], r1 = p_rect[3];
+		uint32_t n = s[(r1 + 1) * W + c1 + 1] - s[r0 * W + c1 + 1] - s[(r1 + 1) * W + c0] + s[r0 * W + c0];
+		if (n > 0) {
+			return false;
+		}
+		sh_culled++;
+		return true;
+	}
+
+	// True when every camera-visible point lies in front of this box,
+	// or the box is off screen: nothing visible can sample it.
+	static bool box_unseen(const Vector3 &p_lo, const Vector3 &p_hi) {
+		real_t x0 = 1e30, y0 = 1e30, x1 = -1e30, y1 = -1e30, zmin = 1e30;
+		const Projection &m = capture_vp;
+		for (int j = 0; j < 8; j++) {
+			Vector3 c(j & 1 ? p_lo.x : p_hi.x, j & 2 ? p_lo.y : p_hi.y, j & 4 ? p_lo.z : p_hi.z);
+			real_t cx = m.columns[0][0] * c.x + m.columns[1][0] * c.y + m.columns[2][0] * c.z + m.columns[3][0];
+			real_t cy = m.columns[0][1] * c.x + m.columns[1][1] * c.y + m.columns[2][1] * c.z + m.columns[3][1];
+			real_t cw = m.columns[0][3] * c.x + m.columns[1][3] * c.y + m.columns[2][3] * c.z + m.columns[3][3];
+			if (cw < 0.5) {
+				return false;
+			}
+			x0 = MIN(x0, cx / cw);
+			x1 = MAX(x1, cx / cw);
+			y0 = MIN(y0, cy / cw);
+			y1 = MAX(y1, cy / cw);
+			zmin = MIN(zmin, cw);
+		}
+		if (x1 < -1.0 || x0 > 1.0 || y1 < -1.0 || y0 > 1.0) {
+			return true;
+		}
+		zmin -= cam_now.distance_to(capture_pos) * 2.0 + 0.5;
+		int tx0 = CLAMP(int((x0 * 0.5 + 0.5) * w) - 1, 0, w - 1);
+		int tx1 = CLAMP(int((x1 * 0.5 + 0.5) * w) + 1, 0, w - 1);
+		int ty0 = CLAMP(int((y0 * 0.5 + 0.5) * h) - 1, 0, h - 1);
+		int ty1 = CLAMP(int((y1 * 0.5 + 0.5) * h) + 1, 0, h - 1);
+		if ((tx1 - tx0 + 1) * (ty1 - ty0 + 1) > 4096) {
+			return false;
+		}
+		for (int y = ty0; y <= ty1; y++) {
+			const float *row = tiles.ptr() + y * w;
+			for (int x = tx0; x <= tx1; x++) {
+				if (row[x] >= zmin) {
+					return false;
+				}
+			}
+		}
+		return true;
+	}
+
+	// Caster whose whole shadow sweep (and penumbra pad) is unseen.
+	static bool shadow_unseen(const real_t p_b[6], const Vector3 &p_light_travel) {
+		if (w == 0 || tiles.is_empty()) {
+			return false;
+		}
+		sh_tested++;
+		Vector3 lo(MIN(p_b[0], p_b[3]), MIN(p_b[1], p_b[4]), MIN(p_b[2], p_b[5]));
+		Vector3 hi(MAX(p_b[0], p_b[3]), MAX(p_b[1], p_b[4]), MAX(p_b[2], p_b[5]));
+		real_t down = MAX(-p_light_travel.y, (real_t)0.2);
+		real_t len = (hi.y - lo.y + 40.0) / down;
+		int steps = MAX(1, int(Math::ceil(len / 6.0)));
+		Vector3 pad(2.0, 2.0, 2.0);
+		for (int s = 0; s < steps; s++) {
+			Vector3 a = p_light_travel * (len * s / steps);
+			Vector3 b = p_light_travel * (len * (s + 1) / steps);
+			Vector3 slo = lo + a.min(b) - pad;
+			Vector3 shi = hi + a.max(b) + pad;
+			if (!box_unseen(slo, shi)) {
+				return false;
+			}
+		}
+		sh_culled++;
+		return true;
+	}
+
+	static bool occluded(const real_t p_b[6]) {
+		if (w == 0) {
+			return false;
+		}
+		tested++;
+		real_t x0 = 1e30, y0 = 1e30, x1 = -1e30, y1 = -1e30, zmin = 1e30;
+		for (int j = 0; j < 8; j++) {
+			Vector3 c(j & 1 ? p_b[0] : p_b[3], j & 2 ? p_b[1] : p_b[4], j & 4 ? p_b[2] : p_b[5]);
+			const Projection &m = capture_vp;
+			real_t cx = m.columns[0][0] * c.x + m.columns[1][0] * c.y + m.columns[2][0] * c.z + m.columns[3][0];
+			real_t cy = m.columns[0][1] * c.x + m.columns[1][1] * c.y + m.columns[2][1] * c.z + m.columns[3][1];
+			real_t cw = m.columns[0][3] * c.x + m.columns[1][3] * c.y + m.columns[2][3] * c.z + m.columns[3][3];
+			if (cw < 0.5) {
+				return false; // crosses the near region
+			}
+			real_t nx = cx / cw, ny = cy / cw;
+			if (nx < -1.0 || nx > 1.0 || ny < -1.0 || ny > 1.0) {
+				return false; // not fully inside the captured view
+			}
+			x0 = MIN(x0, nx);
+			x1 = MAX(x1, nx);
+			y0 = MIN(y0, ny);
+			y1 = MAX(y1, ny);
+			zmin = MIN(zmin, cw);
+		}
+		// parallax slack for camera motion since capture
+		real_t slack = cam_now.distance_to(capture_pos) * 2.0 + 0.5;
+		zmin -= slack;
+		int tx0 = CLAMP(int((x0 * 0.5 + 0.5) * w) - 1, 0, w - 1);
+		int tx1 = CLAMP(int((x1 * 0.5 + 0.5) * w) + 1, 0, w - 1);
+		int ty0 = CLAMP(int((y0 * 0.5 + 0.5) * h) - 1, 0, h - 1);
+		int ty1 = CLAMP(int((y1 * 0.5 + 0.5) * h) + 1, 0, h - 1);
+		if ((tx1 - tx0 + 1) * (ty1 - ty0 + 1) > 2048) {
+			return false;
+		}
+		for (int y = ty0; y <= ty1; y++) {
+			const float *row = tiles.ptr() + y * w;
+			for (int x = tx0; x <= tx1; x++) {
+				if (row[x] >= zmin) {
+					return false;
+				}
+			}
+		}
+		culled++;
+		return true;
+	}
+};
