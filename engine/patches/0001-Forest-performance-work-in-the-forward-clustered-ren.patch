 		if (p_type == LIGHT_TYPE_OMNI && cluster_count_by_type[ELEMENT_TYPE_OMNI_LIGHT] == max_elements_by_type) {
 			return; // Max number elements reached.
diff --git a/servers/rendering/renderer_rd/forward_clustered/forest_cluster.cpp b/servers/rendering/renderer_rd/forward_clustered/forest_cluster.cpp
new file mode 100644
index 0000000000..6965b82ae3
--- /dev/null
+++ b/servers/rendering/renderer_rd/forward_clustered/forest_cluster.cpp
@@ -0,0 +1,488 @@
+/**************************************************************************/
+/*  forest_cluster.cpp                                                    */
+/**************************************************************************/
+
+// forest-perf: GPU cluster culling for dense foliage. Chosen mesh
+// surfaces are split into 128-triangle clusters; each frame a compute
+// pass tests every cluster of every drawn instance against the camera
+// frustum and the previous frame's depth tiles, compacts the visible
+// clusters into an index buffer and writes one indirect draw per
+// instance. The camera prepass and colour pass draw those instead of
+// the full surface. Shadow passes keep the full surface.
+
+#include "render_forward_clustered.h"
+
+#include "core/os/os.h"
+#include "servers/rendering/forest_occ.h"
+#include "servers/rendering/renderer_rd/storage_rd/mesh_storage.h"
+#include "servers/rendering/renderer_rd/uniform_set_cache_rd.h"
+#include "servers/rendering/rendering_server.h"
+
+using namespace RendererSceneRenderImplementation;
+
+static const char *forest_cl_glsl = R"(
+#version 450
+layout(local_size_x = 256) in;
+struct Cluster {
+	vec4 mn;
+	vec4 mx;
+};
+layout(set = 0, binding = 0, std430) readonly buffer Clusters { Cluster cl[]; };
+layout(set = 0, binding = 1, std430) readonly buffer Insts { vec4 inst[]; };
+layout(set = 0, binding = 2, std430) readonly buffer Params {
+	mat4 prev_vp;
+	vec4 planes[6];
+	vec4 cam;
+	uvec4 a;
+} P;
+layout(set = 0, binding = 3, std430) readonly buffer Tiles { float tiles[]; };
+layout(set = 0, binding = 4, std430) buffer Counts { uint counts[]; };
+layout(set = 0, binding = 5, std430) buffer Vis { uint vis[]; };
+layout(set = 0, binding = 6, std430) buffer Indirect { uint cmd[]; };
+layout(set = 0, binding = 7, std430) readonly buffer Src { uint src[]; };
+layout(set = 0, binding = 8, std430) buffer Dst { uint dst[]; };
+layout(push_constant, std430) uniform PC {
+	uint mode;
+	uint inst_count;
+	uint cluster_count;
+	uint slot_base;
+	uint full_count;
+	uint cap;
+	uint pad0;
+	uint pad1;
+} pc;
+
+shared uint s_cnt;
+shared uint s_base;
+shared uint s_scan[256];
+
+bool cluster_visible(uint ii, uint c) {
+	vec4 r0 = inst[ii * 4u];
+	vec4 r1 = inst[ii * 4u + 1u];
+	vec4 r2 = inst[ii * 4u + 2u];
+	vec3 mn = cl[c].mn.xyz;
+	vec3 mx = cl[c].mx.xyz;
+	vec3 oc = (mn + mx) * 0.5;
+	vec3 oe = (mx - mn) * 0.5;
+	vec3 wc = vec3(dot(r0.xyz, oc) + r0.w, dot(r1.xyz, oc) + r1.w, dot(r2.xyz, oc) + r2.w);
+	vec3 we = vec3(dot(abs(r0.xyz), oe), dot(abs(r1.xyz), oe), dot(abs(r2.xyz), oe));
+	for (int p = 0; p < 6; p++) {
+		vec4 pl = P.planes[p];
+		if (dot(pl.xyz, wc) - pl.w - dot(abs(pl.xyz), we) > 0.0) {
+			return false;
+		}
+	}
+	if (P.a.z == 0u) {
+		return true;
+	}
+	float x0 = 1e30, y0 = 1e30, x1 = -1e30, y1 = -1e30, zmin = 1e30;
+	for (int j = 0; j < 8; j++) {
+		vec3 s = vec3((j & 1) != 0 ? 1.0 : -1.0, (j & 2) != 0 ? 1.0 : -1.0, (j & 4) != 0 ? 1.0 : -1.0);
+		vec4 cp = P.prev_vp * vec4(wc + we * s, 1.0);
+		if (cp.w < 0.5) {
+			return true;
+		}
+		vec2 nd = cp.xy / cp.w;
+		if (nd.x < -1.0 || nd.x > 1.0 || nd.y < -1.0 || nd.y > 1.0) {
+			return true;
+		}
+		x0 = min(x0, nd.x);
+		x1 = max(x1, nd.x);
+		y0 = min(y0, nd.y);
+		y1 = max(y1, nd.y);
+		zmin = min(zmin, cp.w);
+	}
+	zmin -= P.cam.w;
+	int W = int(P.a.x);
+	int H = int(P.a.y);
+	int tx0 = clamp(int((x0 * 0.5 + 0.5) * float(W)) - 1, 0, W - 1);
+	int tx1 = clamp(int((x1 * 0.5 + 0.5) * float(W)) + 1, 0, W - 1);
+	int ty0 = clamp(int((y0 * 0.5 + 0.5) * float(H)) - 1, 0, H - 1);
+	int ty1 = clamp(int((y1 * 0.5 + 0.5) * float(H)) + 1, 0, H - 1);
+	if ((tx1 - tx0 + 1) * (ty1 - ty0 + 1) > 256) {
+		return true;
+	}
+	for (int y = ty0; y <= ty1; y++) {
+		for (int x = tx0; x <= tx1; x++) {
+			if (tiles[y * W + x] >= zmin) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+void main() {
+	uint tid = gl_LocalInvocationID.x;
+	uint ii = gl_WorkGroupID.x;
+	uint vw = (pc.cluster_count + 31u) / 32u;
+	if (pc.mode == 0u) {
+		if (tid == 0u) {
+			s_cnt = 0u;
+		}
+		barrier();
+		for (uint c = tid; c < pc.cluster_count; c += 256u) {
+			if (cluster_visible(ii, c)) {
+				atomicOr(vis[ii * vw + c / 32u], 1u << (c % 32u));
+				atomicAdd(s_cnt, floatBitsToUint(cl[c].mx.w));
+			}
+		}
+		barrier();
+		if (tid == 0u) {
+			counts[ii] = s_cnt;
+		}
+	} else if (pc.mode == 1u) {
+		if (tid == 0u && ii == 0u) {
+			uint off = 0u;
+			for (uint k = 0u; k < pc.inst_count; k++) {
+				uint n = counts[k];
+				uint first_inst = floatBitsToUint(inst[k * 4u + 3u].x);
+				uint b = (pc.slot_base + k) * 5u;
+				if (off + n > pc.cap) {
+					// overflow: draw the full surface from region 0
+					cmd[b] = pc.full_count;
+					cmd[b + 2u] = 0u;
+					counts[k] = 0xFFFFFFFFu;
+				} else {
+					cmd[b] = n;
+					cmd[b + 2u] = pc.full_count + off;
+					counts[k] = off;
+					off += n;
+				}
+				cmd[b + 1u] = 1u;
+				cmd[b + 3u] = 0u;
+				cmd[b + 4u] = first_inst;
+			}
+		}
+	} else {
+		uint off = counts[ii];
+		if (off == 0xFFFFFFFFu) {
+			return;
+		}
+		if (tid == 0u) {
+			s_base = 0u;
+		}
+		barrier();
+		for (uint c0 = 0u; c0 < pc.cluster_count; c0 += 256u) {
+			uint c = c0 + tid;
+			uint n = 0u;
+			if (c < pc.cluster_count && (vis[ii * vw + c / 32u] & (1u << (c % 32u))) != 0u) {
+				n = floatBitsToUint(cl[c].mx.w);
+			}
+			s_scan[tid] = n;
+			barrier();
+			for (uint s = 1u; s < 256u; s <<= 1u) {
+				uint v = tid >= s ? s_scan[tid - s] : 0u;
+				barrier();
+				s_scan[tid] += v;
+				barrier();
+			}
+			uint local_off = s_base + s_scan[tid] - n;
+			if (n > 0u) {
+				uint first = floatBitsToUint(cl[c].mn.w);
+				uint d = pc.full_count + off + local_off;
+				for (uint k = 0u; k < n; k++) {
+					dst[d + k] = src[first + k];
+				}
+			}
+			barrier();
+			if (tid == 255u) {
+				s_base += s_scan[255];
+			}
+			barrier();
+		}
+	}
+	// keep every binding referenced in every mode
+	if (pc.mode == 99u) {
+		dst[0] = src[0] + uint(tiles[0]) + cmd[0] + vis[0] + counts[0] + uint(P.cam.x) + uint(inst[0].x) + uint(cl[0].mn.x);
+	}
+}
+)";
+
+static uint32_t forest_morton3(uint32_t x, uint32_t y, uint32_t z) {
+	auto spread = [](uint32_t v) -> uint32_t {
+		v &= 0x3ff;
+		v = (v | (v << 16)) & 0x030000FF;
+		v = (v | (v << 8)) & 0x0300F00F;
+		v = (v | (v << 4)) & 0x030C30C3;
+		v = (v | (v << 2)) & 0x09249249;
+		return v;
+	};
+	return spread(x) | (spread(y) << 1) | (spread(z) << 2);
+}
+
+int RenderForwardClustered::_forest_cluster_mesh_index(GeometryInstanceSurfaceDataCache *p_surf) {
+	for (uint32_t m = 0; m < forest_cmeshes.size(); m++) {
+		if (forest_cmeshes[m].surface == p_surf->surface) {
+			return m;
+		}
+	}
+	for (uint32_t m = 0; m < forest_cluster_skip.size(); m++) {
+		if (forest_cluster_skip[m] == (uint32_t)(uintptr_t)p_surf->surface) {
+			return -1;
+		}
+	}
+	RendererRD::MeshStorage *ms = RendererRD::MeshStorage::get_singleton();
+	uint32_t ic = ms->forest_mesh_surface_get_index_count(p_surf->surface);
+	bool want = false;
+	for (uint32_t t : forest_cluster_tris) {
+		if (ic == t * 3) {
+			want = true;
+		}
+	}
+	if (!want || (p_surf->owner->base_flags & (INSTANCE_DATA_FLAG_MULTIMESH | INSTANCE_DATA_FLAG_PARTICLES)) || p_surf->owner->mesh_instance.is_valid()) {
+		forest_cluster_skip.push_back((uint32_t)(uintptr_t)p_surf->surface);
+		return -1;
+	}
+
+	// build clusters from the surface arrays, once
+	RenderingServerTypes::SurfaceData sd = static_cast<RendererMeshStorage *>(ms)->mesh_get_surface(p_surf->owner->data->base, p_surf->surface_index);
+	Array arr = RenderingServer::get_singleton()->mesh_create_arrays_from_surface_data(sd);
+	PackedVector3Array verts = arr[RSE::ARRAY_VERTEX];
+	PackedInt32Array idx = arr[RSE::ARRAY_INDEX];
+	uint32_t tri_count = idx.size() / 3;
+	ERR_FAIL_COND_V(tri_count == 0, -1);
+	AABB box;
+	box.position = verts[0];
+	for (const Vector3 &v : verts) {
+		box.expand_to(v);
+	}
+	Vector3 inv = Vector3(1, 1, 1) / box.size.maxf(1e-4);
+	struct Tri {
+		uint32_t key;
+		uint32_t t;
+	};
+	LocalVector<Tri> tris;
+	tris.resize(tri_count);
+	for (uint32_t t = 0; t < tri_count; t++) {
+		Vector3 c = (verts[idx[t * 3]] + verts[idx[t * 3 + 1]] + verts[idx[t * 3 + 2]]) / 3.0;
+		Vector3 n = (c - box.position) * inv * 1023.0;
+		tris[t] = { forest_morton3(uint32_t(n.x), uint32_t(n.y), uint32_t(n.z)), t };
+	}
+	struct ByKey {
+		_FORCE_INLINE_ bool operator()(const Tri &a, const Tri &b) const { return a.key < b.key; }
+	};
+	SortArray<Tri, ByKey> sorter;
+	sorter.sort(tris.ptr(), tri_count);
+
+	const uint32_t CT = 128;
+	const real_t wind_pad = 0.35; // largest wind displacement
+	uint32_t ncl = (tri_count + CT - 1) / CT;
+	LocalVector<uint32_t> sorted;
+	sorted.resize(tri_count * 3);
+	LocalVector<float> cl;
+	cl.resize(ncl * 8);
+	for (uint32_t c = 0; c < ncl; c++) {
+		AABB cb;
+		bool first = true;
+		uint32_t t0 = c * CT, t1 = MIN(tri_count, t0 + CT);
+		for (uint32_t k = t0; k < t1; k++) {
+			for (int e = 0; e < 3; e++) {
+				uint32_t vi = idx[tris[k].t * 3 + e];
+				sorted[k * 3 + e] = vi;
+				if (first) {
+					cb.position = verts[vi];
+					first = false;
+				} else {
+					cb.expand_to(verts[vi]);
+				}
+			}
+		}
+		cb = cb.grow(wind_pad);
+		uint32_t fi = t0 * 3, cnt = (t1 - t0) * 3;
+		float *o = cl.ptr() + c * 8;
+		o[0] = cb.position.x;
+		o[1] = cb.position.y;
+		o[2] = cb.position.z;
+		memcpy(&o[3], &fi, 4);
+		o[4] = cb.position.x + cb.size.x;
+		o[5] = cb.position.y + cb.size.y;
+		o[6] = cb.position.z + cb.size.z;
+		memcpy(&o[7], &cnt, 4);
+	}
+	RD *rd = RD::get_singleton();
+	ForestClusterMesh fm;
+	fm.surface = p_surf->surface;
+	fm.cluster_count = ncl;
+	fm.index_count = tri_count * 3;
+	fm.sorted_idx = rd->storage_buffer_create(sorted.size() * 4, Span<uint8_t>((uint8_t *)sorted.ptr(), sorted.size() * 4));
+	fm.clusters = rd->storage_buffer_create(cl.size() * 4, Span<uint8_t>((uint8_t *)cl.ptr(), cl.size() * 4));
+	// region 0 holds the full sorted surface, for overflow
+	fm.out_cap = MAX(fm.index_count * 48u, 32u * 1024u * 1024u);
+	fm.out_idx = rd->index_buffer_create(fm.index_count + fm.out_cap, RD::INDEX_BUFFER_FORMAT_UINT32, Span<uint8_t>(), false, RD::BUFFER_CREATION_AS_STORAGE_BIT);
+	rd->buffer_update(fm.out_idx, 0, fm.index_count * 4, sorted.ptr());
+	fm.out_array = rd->index_array_create(fm.out_idx, 0, fm.index_count + fm.out_cap);
+	forest_cmeshes.push_back(fm);
+	print_line(vformat("FOREST cluster mesh: %d tris, %d clusters", tri_count, ncl));
+	return forest_cmeshes.size() - 1;
+}
+
+void RenderForwardClustered::_forest_cluster_prepare(RenderDataRD *p_render_data) {
+	RenderList &rl = render_list[RENDER_LIST_OPAQUE];
+	uint32_t n = rl.elements.size();
+	forest_cl_slot.resize(n);
+	forest_cl_mesh_of.resize(n);
+	for (uint32_t i = 0; i < n; i++) {
+		forest_cl_slot[i] = -1;
+		forest_cl_mesh_of[i] = -1;
+	}
+	if (forest_cluster_tris.is_empty() || n == 0) {
+		return;
+	}
+	for (ForestClusterMesh &fm : forest_cmeshes) {
+		fm.slot_count = 0;
+		fm.inst_data.clear();
+	}
+	// walk draw groups exactly as _render_list_template does
+	for (uint32_t i = 0; i < n;) {
+		uint32_t rep = MAX(rl.element_info[i].repeat, 1u);
+		for (uint32_t k = 0; k < rep && i + k < n; k++) {
+			GeometryInstanceSurfaceDataCache *s = rl.elements[i + k];
+			int m = _forest_cluster_mesh_index(s);
+			if (m < 0) {
+				continue;
+			}
+			ForestClusterMesh &fm = forest_cmeshes[m];
+			forest_cl_mesh_of[i + k] = m;
+			forest_cl_slot[i + k] = fm.slot_count++;
+			const Transform3D &xf = s->owner->transform;
+			for (int r = 0; r < 3; r++) {
+				fm.inst_data.push_back(xf.basis.rows[r].x);
+				fm.inst_data.push_back(xf.basis.rows[r].y);
+				fm.inst_data.push_back(xf.basis.rows[r].z);
+				fm.inst_data.push_back(xf.origin[r]);
+			}
+			uint32_t fi = k;
+			float ff;
+			memcpy(&ff, &fi, 4);
+			fm.inst_data.push_back(ff);
+			fm.inst_data.push_back(0);
+			fm.inst_data.push_back(0);
+			fm.inst_data.push_back(0);
+		}
+		i += rep;
+	}
+	uint32_t total = 0;
+	for (ForestClusterMesh &fm : forest_cmeshes) {
+		fm.first_slot = total;
+		total += fm.slot_count;
+	}
+	if (total == 0) {
+		return;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		if (forest_cl_mesh_of[i] >= 0) {
+			forest_cl_slot[i] += forest_cmeshes[forest_cl_mesh_of[i]].first_slot;
+		}
+	}
+
+	RD *rd = RD::get_singleton();
+	if (forest_cl_shader.is_null()) {
+		String err;
+		Vector<uint8_t> spirv = rd->shader_compile_spirv_from_source(RD::SHADER_STAGE_COMPUTE, forest_cl_glsl, RD::SHADER_LANGUAGE_GLSL, &err);
+		ERR_FAIL_COND_MSG(spirv.is_empty(), "forest cluster shader: " + err);
+		Vector<RD::ShaderStageSPIRVData> stages;
+		RD::ShaderStageSPIRVData sdata;
+		sdata.shader_stage = RD::SHADER_STAGE_COMPUTE;
+		sdata.spirv = spirv;
+		stages.push_back(sdata);
+		forest_cl_shader = rd->shader_create_from_spirv(stages, "ForestCluster");
+		forest_cl_pipeline = rd->compute_pipeline_create(forest_cl_shader);
+		forest_cl_params = rd->storage_buffer_create(256);
+	}
+	if (total > forest_cl_indirect_cap) {
+		if (forest_cl_indirect.is_valid()) {
+			rd->free_rid(forest_cl_indirect);
+		}
+		forest_cl_indirect_cap = MAX(total * 2, 1024u);
+		forest_cl_indirect = rd->storage_buffer_create(forest_cl_indirect_cap * 20, Span<uint8_t>(), RD::STORAGE_BUFFER_USAGE_DISPATCH_INDIRECT);
+	}
+
+	// camera planes, previous-frame depth tiles and their camera
+	struct {
+		float prev_vp[16];
+		float planes[24];
+		float cam[4];
+		uint32_t a[4];
+	} params = {};
+	Projection pvp = forest_occ_last_vp;
+	for (int c = 0; c < 4; c++) {
+		for (int r = 0; r < 4; r++) {
+			params.prev_vp[c * 4 + r] = pvp.columns[c][r];
+		}
+	}
+	Vector<Plane> planes = p_render_data->scene_data->cam_projection.get_projection_planes(p_render_data->scene_data->cam_transform);
+	for (int p = 0; p < MIN(planes.size(), 6); p++) {
+		params.planes[p * 4 + 0] = planes[p].normal.x;
+		params.planes[p * 4 + 1] = planes[p].normal.y;
+		params.planes[p * 4 + 2] = planes[p].normal.z;
+		params.planes[p * 4 + 3] = planes[p].d;
+	}
+	Vector3 cam_now = p_render_data->scene_data->cam_transform.origin;
+	params.cam[0] = cam_now.x;
+	params.cam[1] = cam_now.y;
+	params.cam[2] = cam_now.z;
+	params.cam[3] = cam_now.distance_to(forest_occ_last_pos) * 2.0 + 0.5;
+	bool occ_on = forest_occ_last_valid && forest_occ_buffer.is_valid() && ForestOcc::w > 0;
+	params.a[0] = occ_on ? ForestOcc::w : 0;
+	params.a[1] = occ_on ? ForestOcc::h : 0;
+	params.a[2] = occ_on ? 1 : 0;
+	rd->buffer_update(forest_cl_params, 0, sizeof(params), &params);
+	RID tiles = occ_on ? forest_occ_buffer : forest_cl_params;
+
+	for (ForestClusterMesh &fm : forest_cmeshes) {
+		if (fm.slot_count == 0) {
+			continue;
+		}
+		uint32_t vw = (fm.cluster_count + 31) / 32;
+		if (fm.slot_count > fm.inst_cap) {
+			if (fm.inst_buf.is_valid()) {
+				rd->free_rid(fm.inst_buf);
+				rd->free_rid(fm.counts_buf);
+				rd->free_rid(fm.vis_buf);
+			}
+			fm.inst_cap = MAX(fm.slot_count * 2, 64u);
+			fm.inst_buf = rd->storage_buffer_create(fm.inst_cap * 64);
+			fm.counts_buf = rd->storage_buffer_create(fm.inst_cap * 4);
+			fm.vis_buf = rd->storage_buffer_create(fm.inst_cap * vw * 4);
+		}
+		rd->buffer_update(fm.inst_buf, 0, fm.inst_data.size() * 4, fm.inst_data.ptr());
+		rd->buffer_clear(fm.vis_buf, 0, fm.slot_count * vw * 4);
+		RD::Uniform u0(RD::UNIFORM_TYPE_STORAGE_BUFFER, 0, fm.clusters);
+		RD::Uniform u1(RD::UNIFORM_TYPE_STORAGE_BUFFER, 1, fm.inst_buf);
+		RD::Uniform u2(RD::UNIFORM_TYPE_STORAGE_BUFFER, 2, forest_cl_params);
+		RD::Uniform u3(RD::UNIFORM_TYPE_STORAGE_BUFFER, 3, tiles);
+		RD::Uniform u4(RD::UNIFORM_TYPE_STORAGE_BUFFER, 4, fm.counts_buf);
+		RD::Uniform u5(RD::UNIFORM_TYPE_STORAGE_BUFFER, 5, fm.vis_buf);
+		RD::Uniform u6(RD::UNIFORM_TYPE_STORAGE_BUFFER, 6, forest_cl_indirect);
+		RD::Uniform u7(RD::UNIFORM_TYPE_STORAGE_BUFFER, 7, fm.sorted_idx);
+		RD::Uniform u8(RD::UNIFORM_TYPE_STORAGE_BUFFER, 8, fm.out_idx);
+		RID uset = UniformSetCacheRD::get_singleton()->get_cache(forest_cl_shader, 0, u0, u1, u2, u3, u4, u5, u6, u7, u8);
+		struct {
+			uint32_t mode, inst_count, cluster_count, slot_base, full_count, cap, p0, p1;
+		} pc = { 0, fm.slot_count, fm.cluster_count, fm.first_slot, fm.index_count, fm.out_cap, 0, 0 };
+		RD::ComputeListID cl = rd->compute_list_begin();
+		rd->compute_list_bind_compute_pipeline(cl, forest_cl_pipeline);
+		rd->compute_list_bind_uniform_set(cl, uset, 0);
+		rd->compute_list_set_push_constant(cl, &pc, sizeof(pc));
+		rd->compute_list_dispatch(cl, fm.slot_count, 1, 1);
+		rd->compute_list_add_barrier(cl);
+		pc.mode = 1;
+		rd->compute_list_set_push_constant(cl, &pc, sizeof(pc));
+		rd->compute_list_dispatch(cl, 1, 1, 1);
+		rd->compute_list_add_barrier(cl);
+		pc.mode = 2;
+		rd->compute_list_set_push_constant(cl, &pc, sizeof(pc));
+		rd->compute_list_dispatch(cl, fm.slot_count, 1, 1);
