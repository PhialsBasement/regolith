+bool RendererSceneCull::_forest_shadow_range(const InstanceVisibilityData &p_vis_data, const Vector3 &p_camera_pos, real_t p_lod_distance) {
+	// Range test at the coarser of camera distance and cascade detail.
+	float dist = MAX(p_camera_pos.distance_to(p_vis_data.position), (float)p_lod_distance);
+	if (p_vis_data.range_end > 0.0f && dist > p_vis_data.range_end) {
+		return false;
+	}
+	return !(p_vis_data.range_begin > 0.0f && dist < p_vis_data.range_begin);
+}
